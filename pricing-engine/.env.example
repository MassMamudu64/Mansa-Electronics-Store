# =============================================================================
# ShopMansa Pricing Engine — environment template
# Copy to .env and fill in real values. .env is gitignored.
# =============================================================================

ENV=development

# ─── Service auth (REQUIRED) ─────────────────────────────────────────────────
# Token that callers (Next.js /api/pricing/*, cron) present as
# `Authorization: Bearer <token>`. Must match `PRICING_API_KEY` in the Next.js
# .env.local. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PRICING_API_KEY=AF2A988E4C1393AD870A88763F10703808B0782BE26A6B5FA5930DE08D832C52
# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Dedicated least-privileged role on the same Supabase Postgres that Next.js
# uses. See README §"Supabase write strategy" for the SQL to create this role.
# Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DB
# Use the DIRECT connection (port 5432), NOT the PgBouncer pooler (6543) —
# asyncpg manages its own pool, and PgBouncer transaction mode breaks
# prepared statements and LISTEN/NOTIFY.
DATABASE_URL=postgresql+asyncpg://mansa_pricing_writer:AF2A988E4C1393AD870A88763F10703808B0782BE26A6B5FA5930DE08D832C52@db.jyqkfvrqmjkrxjrypkwa.supabase.co:5432/postgres

# ─── WeSellCellular credentials (REQUIRED) ───────────────────────────────────
# B2B dealer login. URLs must be confirmed against the real portal before
# enabling — placeholders below.
WESELL_USERNAME=masskeita64@gmail.com
WESELL_PASSWORD=Wesellmass@@2026
WESELL_LOGIN_URL=https://www.wesellcellular.com/login
WESELL_INVENTORY_URL=https://www.wesellcellular.com/inventory/export.csv
WESELL_SOURCE_NAME=WeSellCellular
WESELL_BASE_URL=https://www.wesellcellular.com

# Optional — override which form field names the login POST uses.
WESELL_LOGIN_USERNAME_FIELD=username
WESELL_LOGIN_PASSWORD_FIELD=password

# ─── HTTP behavior ───────────────────────────────────────────────────────────
REQUEST_TIMEOUT_S=30
MAX_RETRIES=3
USER_AGENT=ShopMansa-Pricing/0.1 (+https://shopmansa.com)
