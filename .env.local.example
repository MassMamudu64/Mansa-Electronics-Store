# =============================================================================
# Mansa Electronics — environment template
# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Active stack: Prisma → Supabase Postgres. Custom HMAC admin session.
# Resend for transactional email. WeSellCellular pricing engine (FastAPI).
# =============================================================================

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
#
# Runtime connection — Supabase "Transaction pooler" URL (port 6543, PgBouncer).
# `pgbouncer=true&connection_limit=1` is required by Prisma to avoid prepared-
# statement collisions with PgBouncer's transaction pooling.
#
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# URL-encode any special characters in the password (`@` → `%40`, etc.).
DATABASE_URL="postgresql://postgres:REPLACE_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (non-pooled) connection on port 5432.
# Required by `prisma migrate` / `prisma db push` — DDL cannot run through
# PgBouncer transaction mode. Used only at migration time, never at runtime.
DIRECT_URL="postgresql://postgres:REPLACE_PASSWORD@db.REPLACE_PROJECT_REF.supabase.co:5432/postgres"

# ─── Supabase project keys (REQUIRED) ────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Browser-exposed copies (URL + anon key only — NEVER the service role)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# ─── Admin authentication (REQUIRED) ─────────────────────────────────────────
# Custom HMAC-cookie session (NOT Supabase Auth).
# Pair credentials. Add ADMIN_ID_2 / ADMIN_PASSWORD_2, _3, … for more admins.
ADMIN_ID=REPLACE_WITH_ADMIN_ID
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Optional additional admin slots
# ADMIN_ID_2=
# ADMIN_PASSWORD_2=
# ADMIN_ID_3=
# ADMIN_PASSWORD_3=

# Secret used to sign session cookies (HMAC-SHA256). >= 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=REPLACE_WITH_GENERATED_48_BYTE_BASE64URL_SECRET

# ─── Inventory read API key (OPTIONAL) ───────────────────────────────────────
# Send as `x-api-key:` or `Authorization: Bearer`. >= 16 chars to be accepted.
INVENTORY_API_KEY=

# ─── Transactional email (REQUIRED for order confirmations) ──────────────────
# Resend — https://resend.com/api-keys
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
MAIL_FROM="Mansa Electronics <orders@your-domain.com>"
ORDERS_INBOX=owner@your-domain.com

# ─── WeSellCellular pricing engine (Phase 1+) ────────────────────────────────
# Inbound key the scraper / FastAPI service presents when pushing prices into
# Next.js webhook routes. >= 32 chars. Validated with timing-safe compare.
WESELL_INGEST_KEY=

# Outbound: Next.js → FastAPI pricing backend.
# Base URL of the FastAPI service (no trailing slash).
PRICING_API_URL=
# Shared secret the Next.js server sends in `Authorization: Bearer` to FastAPI.
PRICING_API_KEY=

# ─── Public storefront URL ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
