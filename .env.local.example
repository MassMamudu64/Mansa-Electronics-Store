# =============================================================================
# Supabase — uncomment + fill to switch the storefront from localStorage to
# Supabase. Without these vars, the app runs in "local mode" (Zustand cart +
# localStorage products), which is fine for development.
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server-only, never exposed to the browser

# =============================================================================
# SMTP for order email receipts (optional — used by /api/orders today)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_app_password

MAIL_FROM="Mansa Electronics <orders@mansa-electronics.com>"
ORDERS_INBOX=julatechs@gmail.com

# Public storefront URL (used in email body links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
