# SMTP settings for Nodemailer. Any provider that speaks SMTP works (Gmail app password,
# Mailtrap for dev, SendGrid, Resend SMTP, Postmark, etc.).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_app_password

# Who order emails are SENT FROM (usually your SMTP user / a verified sender)
MAIL_FROM="Mansa Electronics <orders@mansa-electronics.com>"

# Who receives every new order (the store operator's inbox)
ORDERS_INBOX=julatechs@gmail.com

# Public storefront URL (used in email body links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
