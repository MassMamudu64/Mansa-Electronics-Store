# =============================================================================
# Mansa Electronics — environment template
# Copy to .env.local and fill in real values. .env.local is gitignored.
# =============================================================================

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Hostinger MySQL connection string. Get the password from hPanel.
# In hPanel → Databases → Remote MySQL, whitelist the IP of your dev/prod
# host, otherwise the connection will fail with "Host not allowed".
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# ─── Admin authentication (REQUIRED) ─────────────────────────────────────────
# Pair credentials. Add ADMIN_ID_2 / ADMIN_PASSWORD_2, _3, … for more admins.
ADMIN_ID=0011
ADMIN_PASSWORD=replace-me

# Secret used to sign session cookies (HMAC-SHA256). >= 32 chars. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-me-with-at-least-32-random-bytes-base64url

# ─── Inventory read API key (OPTIONAL) ───────────────────────────────────────
# Send as `x-api-key:` or `Authorization: Bearer`. >= 16 chars to be accepted.
INVENTORY_API_KEY=

# ─── SMTP for order email receipts (OPTIONAL) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your_app_password

MAIL_FROM="Mansa Electronics <orders@mansa-electronics.com>"
ORDERS_INBOX=owner@mansa-electronics.com

# Public storefront URL (used in email body links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
